{% comment %} Added by DK on 2026-08-06 — Configurable comparison table section. Renders a feature-comparison grid (e.g. "Boond Fragrances vs. Sweets vs. Generic gifts") with merchant-configurable columns and rows. Addable on any template, including product pages — see references/dk-comparison-table-usage-guide.md {% endcomment %}
{% comment %}
  Rebuilt by DK on 2026-08-06 — Columns are now fixed section settings
  (Columns count + Column 1-4 label/image/highlight) instead of
  repeatable column blocks. Reading section.blocks from inside a child
  block never reliably returned sibling blocks' settings in the live
  theme editor (confirmed via inspector: data-col-count kept resolving
  to 1 despite 3 real column blocks existing), so this removes that
  entire class of bug — the section now reads only its own settings,
  which was never unreliable. Rows remain repeatable blocks (they only
  ever read their own settings, never siblings). Check/cross icons are
  now merchant-uploadable images (with the theme's built-in SVGs as
  fallback), matching the reference design's brand-styled icons.
{% endcomment %}

{% liquid
  assign column_count = section.settings.columns_count | plus: 0

  assign highlight_index = 0
  assign highlight_color = ''
  for i in (1..column_count)
    case i
      when 1
        assign is_highlighted = section.settings.col_1_highlight
        assign this_highlight_color = section.settings.col_1_highlight_color
      when 2
        assign is_highlighted = section.settings.col_2_highlight
        assign this_highlight_color = section.settings.col_2_highlight_color
      when 3
        assign is_highlighted = section.settings.col_3_highlight
        assign this_highlight_color = section.settings.col_3_highlight_color
      when 4
        assign is_highlighted = section.settings.col_4_highlight
        assign this_highlight_color = section.settings.col_4_highlight_color
    endcase
    if is_highlighted and highlight_index == 0
      assign highlight_index = i
      assign highlight_color = this_highlight_color
    endif
  endfor
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="dk-comp section color-{{ section.settings.color_scheme }} spacing-style"
  data-col-count="{{ column_count }}"
  data-highlight-col="{{ highlight_index }}"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --dk-comp-col-count: {{ column_count }};
    --dk-comp-highlight-color: {{ highlight_color | default: '#f0e6d2' }};
  "
>
  <div class="dk-comp__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="dk-comp__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="dk-comp__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="dk-comp__scroll">
    <div class="dk-comp__grid">
      <div class="dk-comp__col-header dk-comp__col-header--spacer"></div>
      {%- for i in (1..column_count) -%}
        {%- liquid
          case i
            when 1
              assign col_label = section.settings.col_1_label
              assign col_image = section.settings.col_1_image
              assign col_highlight = section.settings.col_1_highlight
            when 2
              assign col_label = section.settings.col_2_label
              assign col_image = section.settings.col_2_image
              assign col_highlight = section.settings.col_2_highlight
            when 3
              assign col_label = section.settings.col_3_label
              assign col_image = section.settings.col_3_image
              assign col_highlight = section.settings.col_3_highlight
            when 4
              assign col_label = section.settings.col_4_label
              assign col_image = section.settings.col_4_image
              assign col_highlight = section.settings.col_4_highlight
          endcase
        -%}
        <div class="dk-comp__col-header{% if col_highlight %} dk-comp__col-header--highlight{% endif %}">
          {%- if col_image != blank -%}
            <div class="dk-comp__col-image">
              {{ col_image | image_url: width: 200 | image_tag: widths: '100, 150, 200, 300', sizes: '80px', loading: 'lazy', alt: col_label }}
            </div>
          {%- endif -%}
          <p class="dk-comp__col-label">{{ col_label }}</p>
        </div>
      {%- endfor -%}

      {%- comment -%}
        Rows are still repeatable theme blocks — content_for 'blocks'
        renders each one via blocks/_dk-comparison-row.liquid, in order.
      {%- endcomment -%}
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .dk-comp {
    padding: 80px 72px;
  }
  .dk-comp__header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 44px;
    text-align: center;
  }
  .dk-comp__eyebrow {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground, #9B2335);
    opacity: 0.7;
  }
  .dk-comp__heading {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 40px;
    font-weight: 300;
    line-height: 1.1;
    margin: 0;
  }
  .dk-comp__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .dk-comp__grid {
    display: grid;
    grid-template-columns: minmax(160px, 1.4fr) repeat(var(--dk-comp-col-count), minmax(110px, 1fr));
    min-width: 560px;
    row-gap: 0;
  }

  /* Column headers */
  .dk-comp__col-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 16px 12px 24px;
    text-align: center;
  }
  .dk-comp__col-header--spacer {
    background: transparent;
  }
  .dk-comp__col-image img {
    display: block;
    width: 64px;
    height: 64px;
    object-fit: contain;
    margin: 0 auto;
  }
  .dk-comp__col-label {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 15px;
    margin: 0;
  }

  /* Highlighted column background spans the full grid height. The column
     header shades itself directly (col_highlight is read straight from
     section settings above, no cross-block lookups). Row cells don't
     know their own column index at render time, so the highlighted
     column's 1-based position is exposed as data-highlight-col on the
     .dk-comp wrapper and these rules shade the matching cell in every
     row via an ancestor + nth-child selector — one rule per supported
     column position (max 4 columns). +1 accounts for the row-label
     cell that precedes the value cells in each row. */
  .dk-comp__col-header--highlight {
    background-color: var(--dk-comp-highlight-color, #f0e6d2);
    border-radius: 12px 12px 0 0;
  }
  .dk-comp[data-highlight-col="1"] .dk-comp__cell:nth-child(2),
  .dk-comp[data-highlight-col="2"] .dk-comp__cell:nth-child(3),
  .dk-comp[data-highlight-col="3"] .dk-comp__cell:nth-child(4),
  .dk-comp[data-highlight-col="4"] .dk-comp__cell:nth-child(5) {
    background-color: var(--dk-comp-highlight-color, #f0e6d2);
  }

  /* Rows */
  .dk-comp__row {
    display: grid;
    grid-template-columns: minmax(160px, 1.4fr) repeat(4, minmax(110px, 1fr));
    grid-column: 1 / -1;
    border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }
  .dk-comp__row-label {
    display: flex;
    align-items: center;
    padding: 16px 16px 16px 0;
    font-size: 14px;
  }
  .dk-comp__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 12px;
  }
  /* Row blocks always render 4 cells regardless of the section's actual
     column count; hide whichever trailing cells don't have a real
     column to line up with. */
  .dk-comp[data-col-count="1"] .dk-comp__cell:nth-child(n + 3),
  .dk-comp[data-col-count="2"] .dk-comp__cell:nth-child(n + 4),
  .dk-comp[data-col-count="3"] .dk-comp__cell:nth-child(n + 5) {
    display: none;
  }
  .dk-comp__icon img {
    display: block;
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  .dk-comp__icon svg {
    width: 18px;
    height: 18px;
    display: block;
  }
  .dk-comp__icon--check svg {
    color: #2e7d32;
  }
  .dk-comp__icon--cross svg {
    color: #c62828;
  }
  .dk-comp__cell-text {
    font-size: 13px;
    text-align: center;
  }

  @media (max-width: 768px) {
    .dk-comp { padding: 52px 22px; }
    .dk-comp__heading { font-size: clamp(26px, 7vw, 32px); }
    .dk-comp__grid { grid-template-columns: minmax(140px, 1.2fr) repeat(var(--dk-comp-col-count), minmax(96px, 1fr)); }
    .dk-comp__row { grid-template-columns: minmax(140px, 1.2fr) repeat(4, minmax(96px, 1fr)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DK Comparison table",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [
    {
      "type": "_dk-comparison-row"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Why choose us"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "See how we compare"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "select",
      "id": "columns_count",
      "label": "Number of columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "image_picker",
      "id": "check_icon",
      "label": "Checkmark icon (optional)",
      "info": "Uses the theme's default checkmark if none is set."
    },
    {
      "type": "image_picker",
      "id": "cross_icon",
      "label": "Cross icon (optional)",
      "info": "Uses the theme's default cross if none is set."
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "text",
      "id": "col_1_label",
      "label": "Label",
      "default": "Your brand"
    },
    {
      "type": "image_picker",
      "id": "col_1_image",
      "label": "Image (optional)"
    },
    {
      "type": "checkbox",
      "id": "col_1_highlight",
      "label": "Highlight this column",
      "default": true
    },
    {
      "type": "color",
      "id": "col_1_highlight_color",
      "label": "Highlight color",
      "default": "#f0e6d2",
      "visible_if": "{{ section.settings.col_1_highlight }}"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "text",
      "id": "col_2_label",
      "label": "Label",
      "default": "Competitor"
    },
    {
      "type": "image_picker",
      "id": "col_2_image",
      "label": "Image (optional)"
    },
    {
      "type": "checkbox",
      "id": "col_2_highlight",
      "label": "Highlight this column",
      "default": false
    },
    {
      "type": "color",
      "id": "col_2_highlight_color",
      "label": "Highlight color",
      "default": "#f0e6d2",
      "visible_if": "{{ section.settings.col_2_highlight }}"
    },
    {
      "type": "header",
      "content": "Column 3",
      "info": "Only shown if Number of columns is 3 or more."
    },
    {
      "type": "text",
      "id": "col_3_label",
      "label": "Label",
      "default": "Alternative",
      "visible_if": "{{ section.settings.columns_count == '3' or section.settings.columns_count == '4' }}"
    },
    {
      "type": "image_picker",
      "id": "col_3_image",
      "label": "Image (optional)",
      "visible_if": "{{ section.settings.columns_count == '3' or section.settings.columns_count == '4' }}"
    },
    {
      "type": "checkbox",
      "id": "col_3_highlight",
      "label": "Highlight this column",
      "default": false,
      "visible_if": "{{ section.settings.columns_count == '3' or section.settings.columns_count == '4' }}"
    },
    {
      "type": "color",
      "id": "col_3_highlight_color",
      "label": "Highlight color",
      "default": "#f0e6d2",
      "visible_if": "{{ section.settings.col_3_highlight and section.settings.columns_count != '2' }}"
    },
    {
      "type": "header",
      "content": "Column 4",
      "info": "Only shown if Number of columns is 4."
    },
    {
      "type": "text",
      "id": "col_4_label",
      "label": "Label",
      "default": "Generic",
      "visible_if": "{{ section.settings.columns_count == '4' }}"
    },
    {
      "type": "image_picker",
      "id": "col_4_image",
      "label": "Image (optional)",
      "visible_if": "{{ section.settings.columns_count == '4' }}"
    },
    {
      "type": "checkbox",
      "id": "col_4_highlight",
      "label": "Highlight this column",
      "default": false,
      "visible_if": "{{ section.settings.columns_count == '4' }}"
    },
    {
      "type": "color",
      "id": "col_4_highlight_color",
      "label": "Highlight color",
      "default": "#f0e6d2",
      "visible_if": "{{ section.settings.col_4_highlight and section.settings.columns_count == '4' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0, "max": 100, "step": 4, "unit": "px", "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px", "default": 80
    }
  ],
  "presets": [
    {
      "name": "DK Comparison table",
      "settings": {
        "eyebrow": "Why choose us",
        "heading": "Most wedding gifts are forgotten. Choose one guests will actually use.",
        "columns_count": "3",
        "col_1_label": "Boond Fragrances",
        "col_1_highlight": true,
        "col_2_label": "Sweets",
        "col_2_highlight": false,
        "col_3_label": "Generic gifts",
        "col_3_highlight": false
      },
      "blocks": {
        "row-1": {
          "type": "_dk-comparison-row",
          "settings": { "label": "Guests keep it", "cell_1_type": "check", "cell_2_type": "cross", "cell_3_type": "cross" }
        },
        "row-2": {
          "type": "_dk-comparison-row",
          "settings": { "label": "Actually used", "cell_1_type": "check", "cell_2_type": "cross", "cell_3_type": "cross" }
        },
        "row-3": {
          "type": "_dk-comparison-row",
          "settings": { "label": "Handmade", "cell_1_type": "check", "cell_2_type": "cross", "cell_3_type": "cross" }
        },
        "row-4": {
          "type": "_dk-comparison-row",
          "settings": { "label": "Personalized", "cell_1_type": "check", "cell_2_type": "cross", "cell_3_type": "cross" }
        },
        "row-5": {
          "type": "_dk-comparison-row",
          "settings": { "label": "Gift-ready", "cell_1_type": "check", "cell_2_type": "cross", "cell_3_type": "cross" }
        },
        "row-6": {
          "type": "_dk-comparison-row",
          "settings": { "label": "Small & portable", "cell_1_type": "check", "cell_2_type": "cross", "cell_3_type": "cross" }
        },
        "row-7": {
          "type": "_dk-comparison-row",
          "settings": { "label": "Easy to pack", "cell_1_type": "check", "cell_2_type": "cross", "cell_3_type": "cross" }
        },
        "row-8": {
          "type": "_dk-comparison-row",
          "settings": { "label": "Memorable keepsake", "cell_1_type": "check", "cell_2_type": "cross", "cell_3_type": "cross" }
        }
      },
      "block_order": ["row-1", "row-2", "row-3", "row-4", "row-5", "row-6", "row-7", "row-8"]
    }
  ]
}
{% endschema %}
