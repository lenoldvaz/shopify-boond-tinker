

{%- liquid
  assign section_id = section.id | replace: '_', '' | downcase
  assign title = section.settings.title
  assign subtitle = section.settings.subtitle
  assign carousel_mode = section.settings.carousel_mode
  assign scroll_speed = section.settings.scroll_speed
  assign logo_width = section.settings.logo_width
  assign logo_height = section.settings.logo_height
  assign logo_spacing = section.settings.logo_spacing
  assign logo_padding = section.settings.logo_padding
  assign section_padding = section.settings.section_padding
  assign header_spacing = section.settings.header_spacing
  assign logo_background = section.settings.logo_background
  assign logo_border_radius = section.settings.logo_border_radius
  assign logo_filter = section.settings.logo_filter
  assign hover_scale = section.settings.hover_scale
-%}

{%- style -%}
  .fresh-logo-carousel-{{ section_id }} {
    padding: {{ section_padding }}px 0;
    overflow: hidden;
    width: 100%;
  }

  .fresh-logo-carousel__wrapper-{{ section_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .fresh-logo-carousel__header-{{ section_id }} {
    text-align: center;
    margin-bottom: {{ header_spacing }}px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .fresh-logo-carousel__title-{{ section_id }} {
    font-size: {{ section.settings.heading_title_size }}px;
    text-align: {{ section.settings.title_align }};
    margin: 0 0 10px;
    line-height: 1.25;
  }

  .fresh-logo-carousel__subtitle-{{ section_id }} {
    font-size: {{ section.settings.heading_subtitle_size }}px;
    text-align: {{ section.settings.subtitle_align }};
    opacity: 0.8;
    margin: 0;
    line-height: 1.5;
  }

  /* Desktop Marquee / Static Styles */
  .fresh-logo-carousel__viewport-{{ section_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .fresh-logo-carousel__track-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: {{ logo_spacing }}px;
    {% if carousel_mode == 'scrolling' %}
      animation: fresh-logo-scroll-{{ section_id }} {{ scroll_speed }}s linear infinite;
      width: max-content;
    {% else %}
      justify-content: center;
      flex-wrap: wrap;
    {% endif %}
  }

  .fresh-logo-carousel__item-{{ section_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ logo_padding }}px;
    background-color: {{ logo_background }};
    border-radius: {{ logo_border_radius }}px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    width: {{ logo_width }}px;
    height: {{ logo_height }}px;
  }

  .fresh-logo-carousel__item-{{ section_id }}:hover {
    transform: scale({{ hover_scale }});
  }

  .fresh-logo-carousel__img-{{ section_id }} {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: {{ logo_filter }};
  }

  @keyframes fresh-logo-scroll-{{ section_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .fresh-logo-carousel__viewport-{{ section_id }}:hover .fresh-logo-carousel__track-{{ section_id }} {
    animation-play-state: paused;
  }

  /* Mobile & Small Screen Touch Slider Styles */
  @media screen and (max-width: 749px) {
    .fresh-logo-carousel__viewport-{{ section_id }} {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      scroll-snap-type: x mandatory;
      margin: 0 -20px;
      width: calc(100% + 40px);
      padding: 0 20px 10px;
    }

    .fresh-logo-carousel__viewport-{{ section_id }}::-webkit-scrollbar {
      display: none;
    }

    .fresh-logo-carousel__track-{{ section_id }} {
      display: flex !important;
      animation: none !important;
      width: max-content;
      gap: 16px;
      justify-content: flex-start !important;
      transform: none !important;
    }

    .fresh-logo-carousel__item-{{ section_id }} {
      width: {{ logo_width | times: 0.82 | round }}px;
      height: {{ logo_height | times: 0.82 | round }}px;
      scroll-snap-align: start;
    }
  }
{%- endstyle -%}

<div class="fresh-logo-carousel-{{ section_id }} color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="fresh-logo-carousel__wrapper-{{ section_id }}">
    {%- if title != blank or subtitle != blank -%}
      <div class="fresh-logo-carousel__header-{{ section_id }}">
        {%- if title != blank -%}
          <h2 class="fresh-logo-carousel__title-{{ section_id }}">{{ title }}</h2>
        {%- endif -%}
        {%- if subtitle != blank -%}
          <p class="fresh-logo-carousel__subtitle-{{ section_id }}">{{ subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="fresh-logo-carousel__viewport-{{ section_id }}">
      <div class="fresh-logo-carousel__track-{{ section_id }}">
        {%- capture rendered_logos -%}
          {%- for i in (1..16) -%}
            {%- assign logo_key = 'logo_' | append: i -%}
            {%- assign logo = section.settings[logo_key] -%}
            {%- if logo != blank -%}
              <div class="fresh-logo-carousel__item-{{ section_id }}">
                <img
                  src="{{ logo | image_url: width: 300 }}"
                  alt="{{ logo.alt | escape }}"
                  class="fresh-logo-carousel__img-{{ section_id }}"
                  loading="lazy"
                  width="300"
                  height="200"
                >
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {{ rendered_logos }}
        {%- if carousel_mode == 'scrolling' -%}
          {{ rendered_logos }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Logo",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Heading Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "As Featured In"
    },
    {
      "type": "range",
      "id": "heading_title_size",
      "label": "Title Font Size",
      "min": 16,
      "max": 52,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "title_align",
      "label": "Title Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Trusted by leading media and publications"
    },
    {
      "type": "range",
      "id": "heading_subtitle_size",
      "label": "Subtitle Font Size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "subtitle_align",
      "label": "Subtitle Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Publication Logos"
    },
    { "type": "image_picker", "id": "logo_1", "label": "Logo 1" },
    { "type": "image_picker", "id": "logo_2", "label": "Logo 2" },
    { "type": "image_picker", "id": "logo_3", "label": "Logo 3" },
    { "type": "image_picker", "id": "logo_4", "label": "Logo 4" },
    { "type": "image_picker", "id": "logo_5", "label": "Logo 5" },
    { "type": "image_picker", "id": "logo_6", "label": "Logo 6" },
    { "type": "image_picker", "id": "logo_7", "label": "Logo 7" },
    { "type": "image_picker", "id": "logo_8", "label": "Logo 8" },
    { "type": "image_picker", "id": "logo_9", "label": "Logo 9" },
    { "type": "image_picker", "id": "logo_10", "label": "Logo 10" },
    { "type": "image_picker", "id": "logo_11", "label": "Logo 11" },
    { "type": "image_picker", "id": "logo_12", "label": "Logo 12" },
    { "type": "image_picker", "id": "logo_13", "label": "Logo 13" },
    { "type": "image_picker", "id": "logo_14", "label": "Logo 14" },
    { "type": "image_picker", "id": "logo_15", "label": "Logo 15" },
    { "type": "image_picker", "id": "logo_16", "label": "Logo 16" },
    {
      "type": "header",
      "content": "Layout & Sizing"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 220,
      "step": 10,
      "unit": "px",
      "label": "Logo Box Width",
      "default": 130
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Logo Box Height",
      "default": 70
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Logo Spacing Gap",
      "default": 30
    },
    {
      "type": "range",
      "id": "logo_padding",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "Logo Box Inner Padding",
      "default": 15
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Section Vertical Padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "header_spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Header Bottom Spacing",
      "default": 35
    },
    {
      "type": "header",
      "content": "Animation Behavior"
    },
    {
      "type": "select",
      "id": "carousel_mode",
      "label": "Carousel Mode",
      "options": [
        { "value": "scrolling", "label": "Continuous Scrolling" },
        { "value": "static", "label": "Static Grid / Row" }
      ],
      "default": "scrolling"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll Animation Speed",
      "default": 30
    },
    {
      "type": "range",
      "id": "hover_scale",
      "min": 1.0,
      "max": 1.2,
      "step": 0.1,
      "unit": "x",
      "label": "Hover Scale Effect",
      "default": 1.1
    },
    {
      "type": "header",
      "content": "Styling & Filters"
    },
    {
      "type": "color",
      "id": "logo_background",
      "label": "Logo Box Background",
      "default": "#f9f9f9"
    },
    {
      "type": "range",
      "id": "logo_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Logo Box Border Radius",
      "default": 8
    },
    {
      "type": "select",
      "id": "logo_filter",
      "label": "Logo Color Filter",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "grayscale(100%)", "label": "Grayscale" },
        { "value": "opacity(0.65)", "label": "Faded / Opacity" }
      ],
      "default": "grayscale(100%)"
    }
  ],
  "presets": [
    {
      "name": "Custom Logo"
    }
  ]
}
{% endschema %}