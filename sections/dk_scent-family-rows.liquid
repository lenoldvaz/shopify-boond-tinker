{% comment %}
  Added by DK on 2026-08-11 — Scent Family Collection Rows section.
  Renders one stacked row per scent family value found on
  product.metafields.custom.scent_family (the same live, storefront-
  filterable list metafield already used by blocks/dk_scent-family.liquid
  for the pill filters on PDP/product cards). Each row shows a
  merchant-uploaded circular icon + label + description on the left, and
  a grid of that scent family's products (drawn from one merchant-picked
  collection) on the right — matching the reference "Explore by Scent
  Family" design. Rows with zero matching products are skipped.

  Product cards are rendered via the theme's existing product-card block
  (content_for 'block', type: 'product-card') and grid layout
  (.resource-list--grid, defined globally in assets/base.css) — same
  mechanism as sections/dk_tabbed-collections.liquid, so cards look and
  behave identically to the rest of the site (no new card markup here).
{% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="dk-sfr section color-{{ section.settings.color_scheme }} spacing-style"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  <div class="dk-sfr__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="dk-sfr__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="dk-sfr__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  {%- assign source_collection = section.settings.collection -%}
  {%- assign max_products = section.settings.max_products_per_row -%}

  {%- comment -%}
    12 known scent_family values, matching the case statement in
    blocks/dk_scent-family.liquid. Each gets its own row settings
    (sf_{value}_image/label/description) below.
  {%- endcomment -%}
  {%- assign scent_family_values = 'fresh,floral,earthy,spicy,grassy,musky,mild sweet,woody,balsamic,smoky,warm,green' | split: ',' -%}

  {%- for scent_family_value in scent_family_values -%}
    {%- liquid
      assign value_key = scent_family_value | handle | replace: '-', '_'
      assign row_products = '' | split: ','
      assign row_product_count = 0

      if source_collection != blank
        for product in source_collection.products
          if row_product_count >= max_products
            break
          endif
          assign product_scent_families = product.metafields.custom.scent_family.value
          if product_scent_families contains scent_family_value
            assign row_products = row_products | concat: product
            assign row_product_count = row_product_count | plus: 1
          endif
        endfor
      endif
    -%}

    {%- if row_product_count > 0 -%}
      {%- liquid
        assign image_key = 'sf_' | append: value_key | append: '_image'
        assign label_key = 'sf_' | append: value_key | append: '_label'
        assign description_key = 'sf_' | append: value_key | append: '_description'
        assign row_image = section.settings[image_key]
        assign row_label = section.settings[label_key] | default: scent_family_value | capitalize
        assign row_description = section.settings[description_key]
      -%}
      <div class="dk-sfr__row">
        <div class="dk-sfr__row-info">
          {%- if row_image != blank -%}
            <div class="dk-sfr__row-icon">
              {{ row_image | image_url: width: 120 | image_tag: widths: '60, 90, 120', sizes: '60px', loading: 'lazy', alt: row_label }}
            </div>
          {%- endif -%}
          <p class="dk-sfr__row-label">{{ row_label }}</p>
          {%- if row_description != blank -%}
            <p class="dk-sfr__row-description">{{ row_description }}</p>
          {%- endif -%}
        </div>

        <div
          class="resource-list resource-list--grid dk-sfr__row-products"
          style="
            --resource-list-columns: repeat({{ max_products }}, 1fr);
            --resource-list-columns-mobile: repeat(2, 1fr);
            --resource-list-column-gap-desktop: 20px;
            --resource-list-row-gap-desktop: 20px;
          "
        >
          {%- for product in row_products -%}
            <div class="resource-list__item">
              {%- content_for 'block', type: 'product-card', id: 'static-product-card', closest.product: product -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% stylesheet %}
  .dk-sfr {
    padding: 60px 72px;
  }
  .dk-sfr__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    margin-bottom: 44px;
  }
  .dk-sfr__eyebrow {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
    margin: 0;
  }
  .dk-sfr__heading {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 28px;
    font-weight: 400;
    margin: 0;
  }

  .dk-sfr__row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    align-items: start;
    padding-block: 32px;
    border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }
  .dk-sfr__row:first-of-type {
    border-top: none;
  }

  .dk-sfr__row-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .dk-sfr__row-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 8px;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.1));
  }
  .dk-sfr__row-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dk-sfr__row-label {
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 20px;
    font-weight: 400;
    margin: 0;
  }
  .dk-sfr__row-description {
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.65;
    margin: 0;
  }

  .dk-sfr__row-products {
    overflow-x: auto;
  }

  @media (max-width: 768px) {
    .dk-sfr { padding: 40px 20px; }
    .dk-sfr__row {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
{% endstylesheet %}

