{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ shop.url }}/#organization",
        "name": {{ shop.name | json }},
        "url": "{{ shop.url }}",
        "logo": {
          "@type": "ImageObject",
          "url": "https://boondfragrances.com/cdn/shop/files/Logo_off_white_BG-removebg-preview.png?height=58&v=1652888594" 
        },
        "sameAs": [
          "https://www.instagram.com/boondfragrances",
          "https://www.facebook.com/boondfragrances"
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+91-7307953240",
          "contactType": "Customer Support",
          "email": "team@boondfragrances.com",
          "areaServed": "IN",
          "availableLanguage": ["English", "Hindi"]
        }
      },
      {
        "@type": "WebSite",
        "@id": "{{ shop.url }}/#website",
        "url": "{{ shop.url }}",
        "name": {{ shop.name | json }},
        "publisher": {
          "@id": "{{ shop.url }}/#organization"
        },
        "potentialAction": {
          "@type": "SearchAction",
          "target": "{{ shop.url }}/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "ItemList",
        "@id": "{{ shop.url }}/#homepage-products",
        "name": "Featured Products",
        "itemListElement": [
          {%- comment -%} Pulls up to 8 featured products dynamically from your frontpage collection {%- endcomment -%}
          {%- assign featured_collection = collections['frontpage'] -%}
          {%- if featured_collection == blank -%}
            {%- assign featured_collection = collections['all'] -%}
          {%- endif -%}
          
          {%- for product in featured_collection.products limit: 8 -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "url": "{{ shop.url }}{{ product.url }}",
              "name": {{ product.title | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    ]
  }
  </script>
{%- endif -%}


{%- if request.page_type == 'collection' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "@id": "{{ shop.url }}{{ collection.url }}#webpage",
        "url": "{{ shop.url }}{{ collection.url }}",
        "name": {{ collection.title | json }},
        "description": {{ collection.description | strip_html | json }},
        "isPartOf": {
          "@type": "WebSite",
          "@id": "{{ shop.url }}/#website",
          "name": {{ shop.name | json }},
          "url": "{{ shop.url }}"
        }
      },
      {
        "@type": "ItemList",
        "@id": "{{ shop.url }}{{ collection.url }}#itemlist",
        "name": {{ collection.title | json }},
        "numberOfItems": {{ collection.products_count }},
        "itemListElement": [
          {%- for product in collection.products -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "url": "{{ shop.url }}{{ product.url }}",
              "name": {{ product.title | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    ]
  }
  </script>
{%- endif -%}