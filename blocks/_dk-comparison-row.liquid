{% comment %} Added by DK on 2026-08-06 — Row block for the comparison table section (sections/dk_comparison-table.liquid). One instance per feature row (e.g. "Guests keep it", "Handmade"). Supports up to 4 cells — cell 1 maps to the section's Column 1 setting, cell 2 to Column 2, and so on. Each cell can render a checkmark, a cross, or custom text. If the section has fewer than 4 columns, the extra cell settings are simply ignored — see references/dk-comparison-table-usage-guide.md {% endcomment %}
{% comment %} Updated by DK on 2026-08-06 — Reading section.blocks (sibling column blocks) from inside this block never reliably worked in the live theme editor, so columns are no longer blocks at all (see sections/dk_comparison-table.liquid) — this row now only reads section.settings directly, which was never unreliable. Check/cross icons now render the section's merchant-uploaded check_icon/cross_icon images when set, falling back to the theme's built-in SVGs. {% endcomment %}

<div class="dk-comp__row" {{ block.shopify_attributes }}>
  <div class="dk-comp__row-label">{{ block.settings.label }}</div>
  {%- for i in (1..4) -%}
    {%- liquid
      case i
        when 1
          assign cell_type = block.settings.cell_1_type
          assign cell_text = block.settings.cell_1_text
        when 2
          assign cell_type = block.settings.cell_2_type
          assign cell_text = block.settings.cell_2_text
        when 3
          assign cell_type = block.settings.cell_3_type
          assign cell_text = block.settings.cell_3_text
        when 4
          assign cell_type = block.settings.cell_4_type
          assign cell_text = block.settings.cell_4_text
      endcase
    -%}
    <div class="dk-comp__cell" data-col="{{ i }}">
      {%- if cell_type == 'check' -%}
        <span class="dk-comp__icon dk-comp__icon--check">
          {%- if section.settings.check_icon != blank -%}
            {{ section.settings.check_icon | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' }}
          {%- else -%}
            {{ 'icon-checkmark.svg' | inline_asset_content }}
          {%- endif -%}
        </span>
      {%- elsif cell_type == 'cross' -%}
        <span class="dk-comp__icon dk-comp__icon--cross">
          {%- if section.settings.cross_icon != blank -%}
            {{ section.settings.cross_icon | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' }}
          {%- else -%}
            {{ 'icon-close.svg' | inline_asset_content }}
          {%- endif -%}
        </span>
      {%- elsif cell_type == 'custom' and cell_text != blank -%}
        <span class="dk-comp__cell-text">{{ cell_text }}</span>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Comparison row",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Row label",
      "default": "Feature name"
    },
    {
      "type": "header",
      "content": "Column 1 cell"
    },
    {
      "type": "select",
      "id": "cell_1_type",
      "label": "Value",
      "options": [
        { "value": "check", "label": "Checkmark" },
        { "value": "cross", "label": "Cross" },
        { "value": "custom", "label": "Custom text" },
        { "value": "blank", "label": "Blank" }
      ],
      "default": "check"
    },
    {
      "type": "text",
      "id": "cell_1_text",
      "label": "Custom text",
      "visible_if": "{{ block.settings.cell_1_type == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Column 2 cell"
    },
    {
      "type": "select",
      "id": "cell_2_type",
      "label": "Value",
      "options": [
        { "value": "check", "label": "Checkmark" },
        { "value": "cross", "label": "Cross" },
        { "value": "custom", "label": "Custom text" },
        { "value": "blank", "label": "Blank" }
      ],
      "default": "cross"
    },
    {
      "type": "text",
      "id": "cell_2_text",
      "label": "Custom text",
      "visible_if": "{{ block.settings.cell_2_type == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Column 3 cell",
      "info": "Only used if the section's Number of columns is 3 or more."
    },
    {
      "type": "select",
      "id": "cell_3_type",
      "label": "Value",
      "options": [
        { "value": "check", "label": "Checkmark" },
        { "value": "cross", "label": "Cross" },
        { "value": "custom", "label": "Custom text" },
        { "value": "blank", "label": "Blank" }
      ],
      "default": "cross"
    },
    {
      "type": "text",
      "id": "cell_3_text",
      "label": "Custom text",
      "visible_if": "{{ block.settings.cell_3_type == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Column 4 cell",
      "info": "Only used if the section's Number of columns is 4."
    },
    {
      "type": "select",
      "id": "cell_4_type",
      "label": "Value",
      "options": [
        { "value": "check", "label": "Checkmark" },
        { "value": "cross", "label": "Cross" },
        { "value": "custom", "label": "Custom text" },
        { "value": "blank", "label": "Blank" }
      ],
      "default": "blank"
    },
    {
      "type": "text",
      "id": "cell_4_text",
      "label": "Custom text",
      "visible_if": "{{ block.settings.cell_4_type == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Comparison row",
      "settings": {
        "label": "Feature name",
        "cell_1_type": "check",
        "cell_2_type": "cross",
        "cell_3_type": "cross"
      }
    }
  ]
}
{% endschema %}
