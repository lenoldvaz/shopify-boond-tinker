<style>
#header-group,
#header-group > .shopify-section {
  display: contents;
}
header.dk-hdr.dk-hdr--sticky {
  position: sticky;
  top: 0;
  z-index: 1000;
  transition: box-shadow .25s ease, transform .3s ease, height .25s ease;
}
header.dk-hdr.is-scrolled {
  box-shadow: 0 2px 14px rgba(0, 0, 0, .08);
  {% comment %} --dk-hdr-height: 60px !important; /* inline style sets 72px, so !important is needed */ {% endcomment %}
}
header.dk-hdr.is-hidden {
  transform: translateY(-100%);
}
html {
  scroll-padding-top: calc(var(--dk-hdr-offset, 72px) + 8px);
}
.wa-custom-float {
  z-index: 900;
}
</style>
<script>
  window.addEventListener('load', (event) => {
(function () {
  var HIDE_ON_SCROLL_DOWN = false;   // set true for the slide-away behaviour
  var SHRINK_AFTER = 10;             // px scrolled before the shadow appears
  var HIDE_AFTER = 200;              // px before hiding is allowed

  var header, lastY = window.scrollY, ticking = false;

  function drawerOpen() {
    var d = document.getElementById('dkHdrDrawer');
    return d && d.getAttribute('aria-hidden') === 'false';
  }

  function setOffset() {
    if (!header) return;
    document.documentElement.style.setProperty('--dk-hdr-offset', header.offsetHeight + 'px');
  }

  function update() {
    var y = window.scrollY;
    header.classList.toggle('is-scrolled', y > SHRINK_AFTER);

    if (HIDE_ON_SCROLL_DOWN) {
      var goingDown = y > lastY;
      var hide = goingDown && y > HIDE_AFTER && !drawerOpen();
      header.classList.toggle('is-hidden', hide);
    }
    lastY = y;
    ticking = false;
  }

  function onScroll() {
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  }

  function init() {
    header = document.getElementById('dkHdr');
    if (!header) return;
    setOffset();
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', setOffset);
  }

  init();
  // Re-run if the theme editor re-renders the header section
  document.addEventListener('shopify:section:load', function () {
    window.removeEventListener('scroll', onScroll);
    window.removeEventListener('resize', setOffset);
    init();
  });
})();
});
</script>